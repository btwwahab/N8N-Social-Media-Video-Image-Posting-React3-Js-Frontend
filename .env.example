# Authentication Configuration
# Copy this file to .env and fill in your values

# User credentials for authentication
VITE_APP_ADMIN_USERNAME=admin
VITE_APP_ADMIN_EMAIL=admin@example.com
VITE_APP_ADMIN_PASSWORD=your_secure_password_here

# JWT Secret for session management (generate a secure random string)
VITE_APP_JWT_SECRET=your_jwt_secret_key_here

# App configuration
VITE_APP_NAME=AI Social Automation Hub
VITE_APP_VERSION=1.0.0

# Session timeout in minutes (optional)
VITE_APP_SESSION_TIMEOUT=480

# n8n Webhook URLs
# Replace YOUR_N8N_INSTANCE with your actual n8n instance URL
# Webhook IDs should match your imported workflow
# 
# Webhook 1 (Generate Post): Receives topic, returns generated caption + base64 image
# Webhook ID: 36549d14-0976-4efb-b91c-314fbae8df65
VITE_N8N_WEBHOOK_GENERATE_POST=https://YOUR_N8N_INSTANCE.app.n8n.cloud/webhook/36549d14-0976-4efb-b91c-314fbae8df65
#
# Webhook 2 (Confirm Post): Receives platforms, post text, imageUrl - publishes to social media
# Webhook ID: confirm-post
VITE_N8N_WEBHOOK_CONFIRM_POST=https://YOUR_N8N_INSTANCE.app.n8n.cloud/webhook/confirm-post
# Cloudinary Configuration (for image uploads)
VITE_CLOUDINARY_CLOUD_NAME=your_cloud_name_here
VITE_CLOUDINARY_UPLOAD_PRESET=your_upload_preset_here