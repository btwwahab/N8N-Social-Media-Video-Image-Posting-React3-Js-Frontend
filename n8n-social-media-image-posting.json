    {
      "parameters": {
        "jsCode": "const items = $input.all();\n\nconst platformResults = [];\nlet overallSuccess = true;\n\n// Process each platform result\nfor (const item of items) {\n  const platform = item.json.currentPlatform || 'unknown';\n  \n  // Check if the item has error information\n  if (item.json.error) {\n    platformResults.push({\n      platform: platform,\n      status: 'error',\n      message: item.json.error.message || 'Unknown error occurred',\n      details: item.json.error\n    });\n    overallSuccess = false;\n  } else {\n    // Success case\n    platformResults.push({\n      platform: platform,\n      status: 'success',\n      message: `Successfully posted to ${platform}`,\n      details: {\n        id: item.json.id || null,\n        response: item.json\n      }\n    });\n  }\n}\n\n// Build final response\nconst response = {\n  status: overallSuccess ? 'success' : 'partial_success',\n  message: overallSuccess \n    ? 'All posts published successfully' \n    : 'Some posts failed to publish',\n  totalPlatforms: platformResults.length,\n  successCount: platformResults.filter(r => r.status === 'success').length,\n  errorCount: platformResults.filter(r => r.status === 'error').length,\n  platforms: platformResults\n};\n\nreturn [{ json: response }];"
      },
